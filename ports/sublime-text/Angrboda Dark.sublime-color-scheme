{
  "name": "Angrboða Dark",
  "variables": {
    "background": "#141216",
    "surface": "#1D1920",
    "surfaceRaised": "#29222D",
    "foreground": "#F5EFF8",
    "muted": "#B3A8B8",
    "subtle": "#827686",
    "border": "#332B37",
    "red": "#FF718A",
    "violet": "#D6A4FF",
    "green": "#78C98D",
    "yellow": "#F4C86A",
    "blue": "#78B9F2",
    "cyan": "#80CBC4",
    "orange": "#F39A70",
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "var(red)",
    "block_caret": "var(red)",
    "line_highlight": "var(surface)",
    "selection": "var(surfaceRaised)",
    "selection_foreground": "var(foreground)",
    "gutter": "var(background)",
    "gutter_foreground": "var(subtle)",
    "gutter_foreground_highlight": "var(foreground)",
    "guide": "var(border)",
    "active_guide": "var(subtle)",
    "accent": "var(red)",
    "line_diff_added": "var(green)",
    "line_diff_modified": "var(violet)",
    "line_diff_deleted": "var(red)",
  },
  "rules": [
    {
      "name": "Comments",
      "scope": "comment",
      "foreground": "var(muted)",
      "font_style": "italic",
    },
    {
      "name": "Keywords",
      "scope": "keyword, storage",
      "foreground": "var(violet)",
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, support.function",
      "foreground": "var(violet)",
    },
    {
      "name": "Types",
      "scope": "entity.name.type, support.type, storage.type",
      "foreground": "var(yellow)",
    },
    {
      "name": "Strings",
      "scope": "string",
      "foreground": "var(red)",
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "foreground": "var(orange)",
    },
    {
      "name": "Constants",
      "scope": "constant, support.constant",
      "foreground": "var(cyan)",
    },
    {
      "name": "Properties",
      "scope": "variable.other.member, meta.object-literal.key",
      "foreground": "var(cyan)",
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "foreground": "var(cyan)",
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "foreground": "var(subtle)",
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "foreground": "var(red)",
      "font_style": "bold",
    },
  ],
}
