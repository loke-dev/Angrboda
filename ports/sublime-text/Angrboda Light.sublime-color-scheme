{
  "name": "Angrboða Light",
  "variables": {
    "background": "#FCF9FD",
    "surface": "#F3EDF5",
    "surfaceRaised": "#E9DFED",
    "foreground": "#211B24",
    "muted": "#665B6A",
    "subtle": "#807384",
    "border": "#DED2E2",
    "red": "#B52643",
    "violet": "#68459B",
    "green": "#25723A",
    "yellow": "#805C00",
    "blue": "#25659A",
    "cyan": "#176E6B",
    "orange": "#98401D",
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "var(red)",
    "block_caret": "var(red)",
    "line_highlight": "var(surface)",
    "selection": "var(surfaceRaised)",
    "selection_foreground": "var(foreground)",
    "gutter": "var(background)",
    "gutter_foreground": "var(subtle)",
    "gutter_foreground_highlight": "var(foreground)",
    "guide": "var(border)",
    "active_guide": "var(subtle)",
    "accent": "var(red)",
    "line_diff_added": "var(green)",
    "line_diff_modified": "var(violet)",
    "line_diff_deleted": "var(red)",
  },
  "rules": [
    {
      "name": "Comments",
      "scope": "comment",
      "foreground": "var(muted)",
      "font_style": "italic",
    },
    {
      "name": "Keywords",
      "scope": "keyword, storage",
      "foreground": "var(violet)",
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, support.function",
      "foreground": "var(violet)",
    },
    {
      "name": "Types",
      "scope": "entity.name.type, support.type, storage.type",
      "foreground": "var(yellow)",
    },
    {
      "name": "Strings",
      "scope": "string",
      "foreground": "var(red)",
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "foreground": "var(orange)",
    },
    {
      "name": "Constants",
      "scope": "constant, support.constant",
      "foreground": "var(cyan)",
    },
    {
      "name": "Properties",
      "scope": "variable.other.member, meta.object-literal.key",
      "foreground": "var(cyan)",
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "foreground": "var(cyan)",
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "foreground": "var(subtle)",
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "foreground": "var(red)",
      "font_style": "bold",
    },
  ],
}
