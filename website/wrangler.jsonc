{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "angrboda",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "angrboda.loke.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
